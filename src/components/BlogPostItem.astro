---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, date, description, locale, tags } = post.data;
const slug = post.id.replace(/^(en|it)\//, "").replace(/\.md$/, "");
const href = `/blog/${locale}/${slug}`;
const dateLocale = locale === "it" ? "it-IT" : "en-GB";
const formattedDate = new Intl.DateTimeFormat(dateLocale, {
  day: "2-digit",
  month: "short",
}).format(date);
---

<a
  href={href}
  class="group border-silver-700/15 grid w-full gap-2 border-b py-5 transition-colors last:border-b-0 md:grid-cols-[5rem_1fr_auto] md:gap-4"
  title={title}
  lang={locale}
  data-astro-prefetch
>
  <time
    datetime={date.toISOString()}
    class="text-xs font-semibold tracking-wider text-green-700/80 uppercase"
  >
    {formattedDate}
  </time>

  <div class="min-w-0">
    <h5
      class="text-silver-900/90 text-base font-semibold transition-colors group-hover:text-green-700/90"
    >
      {title}
    </h5>
    {
      description && (
        <p class="text-silver-700/65 mt-1 text-sm leading-6">{description}</p>
      )
    }
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="text-silver-700/25 text-xs" aria-hidden="true">·</span>
      <span
        class="rounded-full border border-green-500/25 bg-green-500/10 px-2 py-0.5 text-[0.65rem] font-semibold text-green-700/80 uppercase"
      >
        {locale}
      </span>
      {
        tags.map((tag) => (
          <span class="bg-silver-700/10 text-silver-700/60 rounded-full px-2 py-0.5 text-[0.65rem]">
            #{tag}
          </span>
        ))
      }
    </div>
  </div>

  <span
    class="hidden self-center text-lg text-green-700/70 transition-transform duration-300 group-hover:translate-x-1 md:block"
    aria-hidden="true"
  >
    →
  </span>
</a>
