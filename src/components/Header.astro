---
import { getCollection } from 'astro:content'
import HeaderIntersection from '@/components/HeaderIntersection'
import { getAvatar } from '@/libs/avatar'

const github = (await getCollection('socials')).find((item) => item.id === 'github')?.data

const navigationCollection = await getCollection('navigation')
const navigation = navigationCollection.map((item) => item.data).toSorted((a, b) => a.order - b.order)

const { page } = Astro.props

const avatar = (await getAvatar()).src
---

<HeaderIntersection client:load page={page} github={github} navigation={navigation} avatar={avatar} />
