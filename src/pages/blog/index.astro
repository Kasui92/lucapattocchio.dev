---
import TerminalHeading from '@/components/TerminalHeading.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout page="blog">
    <div class="space-y-16">
        <section class="container flex flex-col items-center">
            <TerminalHeading command="cat" args="~/blog/README.md" />
            <p class="text-muted-foreground text-md mt-4 w-full text-justify leading-7">
                <span class="font-semibold">Well, yes!</span>
                <br />
                I've decided to open a space to share my abstruse reflections and useless thoughts, just to contribute
                in a completely insignificant way to the web chaos. <br />
                After all, everyone has a blog nowadays, <span class="italic">so why not me?</span>
            </p>
        </section>

        <section class="container flex flex-col items-center">
            <TerminalHeading command="tail -f" args="~/blog/posts.log" />
            <div class="mt-4 w-full font-mono text-sm leading-7">
                <p class="text-subtle-foreground"># no articles yet, check back later</p>
            </div>
        </section>
    </div>
</Layout>
